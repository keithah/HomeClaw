---
import TerminalMockup from './TerminalMockup.astro';
---

<section id="hero" class="pt-36 pb-20 px-4 sm:px-6 lg:px-8">
  <div class="max-w-4xl mx-auto text-center" data-animate>
    <!-- Badges -->
    <div class="flex flex-wrap justify-center gap-3 mb-8">
      <span class="bg-accent/10 border border-accent/30 text-accent rounded-full px-3 py-1 text-xs">On the Mac App Store</span>
      <span class="bg-card border border-border rounded-full px-3 py-1 text-xs text-muted">MIT License</span>
      <span class="bg-card border border-border rounded-full px-3 py-1 text-xs text-muted">Free & Open Source</span>
      <span class="bg-card border border-border rounded-full px-3 py-1 text-xs text-muted">8 MCP Tools</span>
      <span class="bg-card border border-border rounded-full px-3 py-1 text-xs text-muted">macOS</span>
    </div>

    <!-- Heading -->
    <h1 class="text-5xl sm:text-6xl lg:text-7xl font-bold tracking-tight">
      <span class="text-foreground">HomeKit,</span><br />
      <span class="bg-gradient-to-r from-accent to-accent-2 bg-clip-text text-transparent bg-[length:200%_auto] animate-gradient-shift">Unboxed</span>
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-lg sm:text-xl text-muted max-w-2xl mx-auto leading-relaxed">
      Apple HomeKit has no public API, no CLI, and no way to talk to AI assistants. HomeClaw fixes that with a CLI, MCP server, and plugins for Claude Code and OpenClaw.
    </p>

    <!-- CTA Buttons -->
    <div class="mt-10 flex flex-col sm:flex-row gap-4 justify-center items-center">
      <a
        href="https://apps.apple.com/us/app/homeclaw/id6759682551?mt=12"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-foreground text-background hover:opacity-90 font-semibold px-6 py-3 rounded-lg transition-all"
        aria-label="Download HomeClaw on the Mac App Store"
      >
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5" aria-hidden="true">
          <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.08zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
        </svg>
        <span>Download on the Mac App Store</span>
      </a>
      <a
        href="#quickstart"
        class="bg-accent hover:bg-accent-2 text-background font-semibold px-6 py-3 rounded-lg transition-all"
      >
        Quick Start
      </a>
      <a
        href="https://github.com/omarshahine/HomeClaw"
        target="_blank"
        rel="noopener noreferrer"
        class="border border-border hover:border-accent text-foreground px-6 py-3 rounded-lg transition-all"
      >
        View on GitHub
      </a>
    </div>
  </div>

  <!-- Terminal mockup hero image -->
  <div class="mt-16 max-w-4xl mx-auto" data-animate>
    <TerminalMockup />
  </div>
</section>
